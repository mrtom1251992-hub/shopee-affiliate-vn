---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  articleDate?: Date;
  articleAuthor?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/images/shiop.webp',
  articleDate,
  articleAuthor = 'Admin',
} = Astro.props;

const siteTitle = 'ShopeeAffVN — Kinh Nghiệm Shopee Affiliate';
const fullTitle = title.includes('ShopeeAffVN') ? title : `${title} | ${siteTitle}`;
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="keywords" content="shopee affiliate, kinh nghiệm shopee affiliate, kiếm tiền shopee, hoa hồng shopee 2026, hướng dẫn shopee affiliate, facebook reels shopee, youtube shorts affiliate" />
<meta name="author" content={articleAuthor} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={articleDate ? "article" : "website"} />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url.origin).href} />
<meta property="og:locale" content="vi_VN" />

<!-- Preload LCP Hero Image on homepage for instant LCP score -->
{Astro.url.pathname === '/' && (
  <link rel="preload" as="image" href="/images/shiop.webp" fetchpriority="high" />
)}

<!-- Non-blocking Google Fonts with preconnect & display=swap (Essential weights only) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" media="print" onload="this.media='all'" />
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
</noscript>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": articleDate ? "Article" : "WebSite",
  "name": fullTitle,
  "headline": title,
  "description": description,
  "url": Astro.url.href,
  "author": {
    "@type": "Person",
    "name": articleAuthor
  },
  "publisher": {
    "@type": "Organization",
    "name": "ShopeeAffVN",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', Astro.site || Astro.url.origin).href
    }
  },
  "datePublished": articleDate ? articleDate.toISOString() : undefined
})} />
