---
// Cat Peek - Animation "Mèo Ló Đầu Ăn Xin Click"
const storefrontUrl = "https://collshp.com/memien2020?view=storefront";
---

<aside class="cat-peek" id="catPeek" aria-hidden="true" role="complementary" aria-label="Ủng hộ kênh">
  <!-- Speech Bubble -->
  <div class="cat-peek__bubble" id="catBubble">
    <span class="cat-peek__bubble-text">Ủng hộ em 1 click nhé 🥺</span>
    <button class="cat-peek__dismiss" id="catPeekDismiss" aria-label="Ẩn bé mèo" title="Tạm ẩn bé mèo">✕</button>
  </div>

  <a 
    href={storefrontUrl} 
    target="_blank" 
    rel="nofollow noopener"
    class="cat-peek__link"
    id="catPeekLink"
    title="Ghé Shopee ủng hộ em 1 click hoa hồng nhé!"
  >
    <!-- Cute Vector Cat -->
    <div class="cat-peek__cat">
      <svg viewBox="0 0 140 105" fill="none" xmlns="http://www.w3.org/2000/svg" class="cat-peek__svg">
        <!-- Floating Heart -->
        <g class="cat-peek__heart">
          <path d="M70,8 C70,1 61,1 61,8 C61,14 70,21 70,21 C70,21 79,14 79,8 C79,1 70,1 70,8Z" fill="#EE4D2D"/>
        </g>

        <!-- Left Ear -->
        <polygon points="26,45 42,12 58,45" fill="#FFA959" stroke="#E88A3C" stroke-width="2"/>
        <polygon points="33,42 42,20 51,42" fill="#FFB7C5"/>
        
        <!-- Right Ear -->
        <polygon points="82,45 98,12 114,45" fill="#FFA959" stroke="#E88A3C" stroke-width="2"/>
        <polygon points="89,42 98,20 107,42" fill="#FFB7C5"/>

        <!-- Head Base -->
        <ellipse cx="70" cy="68" rx="50" ry="38" fill="#FFA959"/>
        
        <!-- Face White Belly/Cheeks Patch -->
        <ellipse cx="70" cy="76" rx="34" ry="26" fill="#FFFBF5"/>
        <ellipse cx="44" cy="76" rx="14" ry="12" fill="#FFFBF5"/>
        <ellipse cx="96" cy="76" rx="14" ry="12" fill="#FFFBF5"/>

        <!-- Left Big Sparkle Eye -->
        <ellipse cx="50" cy="65" rx="9" ry="10" fill="#2B1D0F"/>
        <circle cx="48" cy="62" r="3.8" fill="#FFFFFF"/>
        <circle cx="53" cy="68" r="1.8" fill="#FFFFFF"/>
        <circle cx="47" cy="69" r="1" fill="#FFFFFF"/>

        <!-- Right Big Sparkle Eye -->
        <ellipse cx="90" cy="65" rx="9" ry="10" fill="#2B1D0F"/>
        <circle cx="88" cy="62" r="3.8" fill="#FFFFFF"/>
        <circle cx="93" cy="68" r="1.8" fill="#FFFFFF"/>
        <circle cx="87" cy="69" r="1" fill="#FFFFFF"/>

        <!-- Rosy Blush Cheeks -->
        <ellipse cx="38" cy="74" rx="7" ry="4" fill="#FF8EA3" opacity="0.6"/>
        <ellipse cx="102" cy="74" rx="7" ry="4" fill="#FF8EA3" opacity="0.6"/>

        <!-- Cute Little Pink Nose -->
        <polygon points="70,72 66,76 74,76" fill="#FF708F"/>

        <!-- Cat Smile Mouth (ω shape) -->
        <path d="M63,80 Q66.5,84 70,80 Q73.5,84 77,80" stroke="#8C4A1E" stroke-width="2" fill="none" stroke-linecap="round"/>

        <!-- Whiskers Left -->
        <line x1="14" y1="70" x2="38" y2="73" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>
        <line x1="12" y1="78" x2="37" y2="78" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>

        <!-- Whiskers Right -->
        <line x1="126" y1="70" x2="102" y2="73" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>
        <line x1="128" y1="78" x2="103" y2="78" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>

        <!-- Left Paw Gripping the Edge -->
        <g class="cat-peek__paw-left">
          <ellipse cx="42" cy="100" rx="14" ry="7.5" fill="#FFFBF5" stroke="#FFA959" stroke-width="2.5"/>
          <ellipse cx="36" cy="98" rx="2.5" ry="2" fill="#FFB7C5"/>
          <ellipse cx="42" cy="96" rx="2.5" ry="2" fill="#FFB7C5"/>
          <ellipse cx="48" cy="98" rx="2.5" ry="2" fill="#FFB7C5"/>
        </g>

        <!-- Right Paw Gripping the Edge -->
        <g class="cat-peek__paw-right">
          <ellipse cx="98" cy="100" rx="14" ry="7.5" fill="#FFFBF5" stroke="#FFA959" stroke-width="2.5"/>
          <ellipse cx="92" cy="98" rx="2.5" ry="2" fill="#FFB7C5"/>
          <ellipse cx="98" cy="96" rx="2.5" ry="2" fill="#FFB7C5"/>
          <ellipse cx="104" cy="98" rx="2.5" ry="2" fill="#FFB7C5"/>
        </g>
      </svg>
    </div>
  </a>
</aside>

<style>
  .cat-peek {
    position: fixed;
    bottom: -110px;
    left: var(--space-6, 24px);
    z-index: calc(var(--z-fixed, 100) + 5);
    transition: bottom 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    pointer-events: none;
    user-select: none;
  }

  .cat-peek--visible {
    bottom: 0px;
    pointer-events: auto;
  }

  .cat-peek--visible:hover {
    bottom: 6px;
  }

  .cat-peek__link {
    display: block;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    outline: none;
  }

  .cat-peek__link:focus-visible {
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 0 0 3px var(--color-primary-500, #EE4D2D);
  }

  .cat-peek__cat {
    width: 105px;
    height: 85px;
    overflow: visible;
    transform-origin: bottom center;
    animation: catGentleWiggle 4s ease-in-out infinite;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.16));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cat-peek__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cat-peek--visible:hover .cat-peek__cat {
    animation: catExcitedBounce 0.5s ease-in-out;
    transform: scale(1.08);
  }

  /* Speech Bubble */
  .cat-peek__bubble {
    position: absolute;
    bottom: 82px;
    left: 4px;
    background: #FFFFFF;
    border: 2px solid #FFD4B8;
    border-radius: 16px;
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #EE4D2D;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(238, 77, 45, 0.16);
    opacity: 0;
    transform: scale(0.8) translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: auto;
  }

  .cat-peek__bubble::after {
    content: '';
    position: absolute;
    bottom: -7px;
    left: 28px;
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 7px solid #FFFFFF;
    filter: drop-shadow(0 1px 0 #FFD4B8);
  }

  .cat-peek--visible .cat-peek__bubble {
    opacity: 1;
    transform: scale(1) translateY(0);
    transition-delay: 0.5s;
  }

  .cat-peek--visible:hover .cat-peek__bubble {
    background: #FFF5F0;
    border-color: #EE4D2D;
    transform: scale(1.04) translateY(-2px);
    transition-delay: 0s;
  }

  [data-theme="dark"] .cat-peek__bubble {
    background: #1E293B;
    border-color: #EE4D2D;
    color: #FFA585;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  [data-theme="dark"] .cat-peek__bubble::after {
    border-top-color: #1E293B;
    filter: drop-shadow(0 1px 0 #EE4D2D);
  }

  /* Dismiss Button */
  .cat-peek__dismiss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #F1F5F9;
    color: #64748B;
    border: none;
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, transform 0.2s;
    line-height: 1;
    padding: 0;
    margin-left: 2px;
  }

  .cat-peek__dismiss:hover {
    background: #EE4D2D;
    color: #FFFFFF;
    transform: scale(1.2) rotate(90deg);
  }

  [data-theme="dark"] .cat-peek__dismiss {
    background: #334155;
    color: #94A3B8;
  }

  [data-theme="dark"] .cat-peek__dismiss:hover {
    background: #EE4D2D;
    color: #FFFFFF;
  }

  /* Floating Heart */
  .cat-peek__heart {
    animation: heartPulse 2.2s ease-in-out infinite;
    transform-origin: 70px 10px;
  }

  /* Keyframe Animations */
  @keyframes catGentleWiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-2.5deg); }
    75% { transform: rotate(2.5deg); }
  }

  @keyframes catExcitedBounce {
    0% { transform: translateY(0); }
    25% { transform: translateY(-8px) scale(1.1); }
    50% { transform: translateY(-2px); }
    75% { transform: translateY(-5px); }
    100% { transform: translateY(0) scale(1.08); }
  }

  @keyframes heartPulse {
    0%, 100% { 
      transform: translateY(0) scale(1);
      opacity: 0.85;
    }
    50% { 
      transform: translateY(-5px) scale(1.2);
      opacity: 1;
    }
  }

  /* Responsive Mobile */
  @media (max-width: 768px) {
    .cat-peek {
      left: var(--space-3, 12px);
    }
    .cat-peek__cat {
      width: 90px;
      height: 72px;
    }
    .cat-peek__bubble {
      font-size: 0.75rem;
      padding: 6px 10px;
      bottom: 74px;
      left: 2px;
    }
    .cat-peek--visible {
      bottom: 0px;
    }
  }
</style>

<script is:inline>
  (() => {
    function initCatPeek() {
      const cat = document.getElementById('catPeek');
      const dismissBtn = document.getElementById('catPeekDismiss');
      const catLink = document.getElementById('catPeekLink');
      if (!cat) return;

      let shown = false;

      function showCat() {
        if (shown) return;
        shown = true;
        cat.classList.add('cat-peek--visible');
        cat.setAttribute('aria-hidden', 'false');
      }

      function hideCat() {
        cat.classList.remove('cat-peek--visible');
        cat.setAttribute('aria-hidden', 'true');
      }

      // Hiện nhanh sau 3.5 giây
      const timer = setTimeout(showCat, 3500);

      // Hoặc chỉ cần cuộn trang xuống 150px là hiện ngay
      const onScroll = () => {
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        if (scrollY > 150) {
          clearTimeout(timer);
          showCat();
          window.removeEventListener('scroll', onScroll);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });

      if (dismissBtn) {
        dismissBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          hideCat();
        });
      }

      if (catLink) {
        catLink.addEventListener('click', () => {
          hideCat();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatPeek);
    } else {
      initCatPeek();
    }
  })();
</script>
