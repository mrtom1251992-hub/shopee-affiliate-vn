---
// Cat Peek - Animation "Gia Đình 3 Bé Mèo Ló Đầu Ăn Xin Click"
import { AFFILIATE_REDIRECT_URL } from '../../config/affiliate';
const storefrontUrl = AFFILIATE_REDIRECT_URL;
---

<aside class="cat-peek" id="catPeek" aria-hidden="true" inert role="complementary" aria-label="Ủng hộ kênh">
  <div class="cat-peek__wrapper">
    <!-- Speech Bubble (Luôn nằm TRÊN đỉnh đầu các bé mèo) -->
    <div class="cat-peek__bubble" id="catBubble">
      <span class="cat-peek__bubble-text">3 mẹ con xin 1 click mua cá ạ 🐟🥺</span>
      <button class="cat-peek__dismiss" id="catPeekDismiss" aria-label="Ẩn các bé mèo" title="Tạm ẩn">✕</button>
    </div>

    <!-- Clickable Cat Trio -->
    <a 
      href={storefrontUrl} 
      target="_blank" 
      rel="nofollow noopener"
      class="cat-peek__link"
      id="catPeekLink"
    >
      <div class="cat-peek__stage">
        <svg viewBox="0 0 210 115" fill="none" xmlns="http://www.w3.org/2000/svg" class="cat-peek__svg">
          
          <!-- ══════════════════════════════════════════════
               1. MÈO CON BÊN TRÁI (Bé Xám Tro Cute)
               ══════════════════════════════════════════════ -->
          <g class="cat-peek__kitten-left">
            <!-- Ears -->
            <polygon points="12,58 24,32 36,58" fill="#94A3B8" stroke="#64748B" stroke-width="1.5"/>
            <polygon points="17,56 24,38 31,56" fill="#FFB7C5"/>
            <polygon points="46,58 58,32 70,58" fill="#94A3B8" stroke="#64748B" stroke-width="1.5"/>
            <polygon points="51,56 58,38 65,56" fill="#FFB7C5"/>
            
            <!-- Head -->
            <ellipse cx="41" cy="74" rx="30" ry="24" fill="#94A3B8"/>
            <ellipse cx="41" cy="79" rx="20" ry="16" fill="#F8FAFC"/>

            <!-- Eyes -->
            <ellipse cx="30" cy="73" rx="6" ry="7" fill="#1E293B"/>
            <circle cx="28.5" cy="71" r="2.5" fill="#FFFFFF"/>
            <circle cx="32" cy="75" r="1.2" fill="#FFFFFF"/>

            <ellipse cx="52" cy="73" rx="6" ry="7" fill="#1E293B"/>
            <circle cx="50.5" cy="71" r="2.5" fill="#FFFFFF"/>
            <circle cx="54" cy="75" r="1.2" fill="#FFFFFF"/>

            <!-- Cheeks & Nose -->
            <ellipse cx="22" cy="79" rx="5" ry="3" fill="#FF8EA3" opacity="0.7"/>
            <ellipse cx="60" cy="79" rx="5" ry="3" fill="#FF8EA3" opacity="0.7"/>
            <polygon points="41,78 38,81 44,81" fill="#FF708F"/>
            <path d="M37,84 Q41,87 45,84" stroke="#475569" stroke-width="1.5" fill="none" stroke-linecap="round"/>

            <!-- Whiskers -->
            <line x1="10" y1="76" x2="24" y2="78" stroke="#64748B" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="8" y1="82" x2="23" y2="82" stroke="#64748B" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="72" y1="76" x2="58" y2="78" stroke="#64748B" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="74" y1="82" x2="59" y2="82" stroke="#64748B" stroke-width="1.2" stroke-linecap="round"/>

            <!-- Paws -->
            <ellipse cx="25" cy="98" rx="8" ry="5" fill="#F8FAFC" stroke="#94A3B8" stroke-width="1.5"/>
            <ellipse cx="57" cy="98" rx="8" ry="5" fill="#F8FAFC" stroke="#94A3B8" stroke-width="1.5"/>
          </g>


          <!-- ══════════════════════════════════════════════
               2. MÈO CON BÊN PHẢI (Bé Trắng Kem Mắt Cười)
               ══════════════════════════════════════════════ -->
          <g class="cat-peek__kitten-right">
            <!-- Ears -->
            <polygon points="140,58 152,32 164,58" fill="#FDE68A" stroke="#F59E0B" stroke-width="1.5"/>
            <polygon points="145,56 152,38 159,56" fill="#FFB7C5"/>
            <polygon points="174,58 186,32 198,58" fill="#FDE68A" stroke="#F59E0B" stroke-width="1.5"/>
            <polygon points="179,56 186,38 193,56" fill="#FFB7C5"/>

            <!-- Head -->
            <ellipse cx="169" cy="74" rx="30" ry="24" fill="#FFFBEB" stroke="#FDE68A" stroke-width="1.5"/>
            
            <!-- Eyes (Happy anime squint eyes ^_^) -->
            <path d="M152,74 Q158,67 164,74" stroke="#78350F" stroke-width="2.2" fill="none" stroke-linecap="round"/>
            <path d="M174,74 Q180,67 186,74" stroke="#78350F" stroke-width="2.2" fill="none" stroke-linecap="round"/>

            <!-- Cheeks & Nose -->
            <ellipse cx="150" cy="80" rx="5" ry="3" fill="#FF8EA3" opacity="0.8"/>
            <ellipse cx="188" cy="80" rx="5" ry="3" fill="#FF8EA3" opacity="0.8"/>
            <polygon points="169,78 166,81 172,81" fill="#FF708F"/>
            <path d="M165,83 Q169,87 173,83" stroke="#92400E" stroke-width="1.5" fill="none" stroke-linecap="round"/>

            <!-- Whiskers -->
            <line x1="138" y1="76" x2="152" y2="78" stroke="#D97706" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="136" y1="82" x2="151" y2="82" stroke="#D97706" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="200" y1="76" x2="186" y2="78" stroke="#D97706" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="202" y1="82" x2="187" y2="82" stroke="#D97706" stroke-width="1.2" stroke-linecap="round"/>

            <!-- Paws -->
            <ellipse cx="153" cy="98" rx="8" ry="5" fill="#FFFFFF" stroke="#FDE68A" stroke-width="1.5"/>
            <ellipse cx="185" cy="98" rx="8" ry="5" fill="#FFFFFF" stroke="#FDE68A" stroke-width="1.5"/>
          </g>


          <!-- ══════════════════════════════════════════════
               3. MÈO MẸ Ở GIỮA (Lớn nhất, Trái Tim & Mắt Cầu Xin)
               ══════════════════════════════════════════════ -->
          <g class="cat-peek__mother-cat">
            <!-- Floating Heart with Mini Pulse -->
            <g class="cat-peek__heart">
              <path d="M105,8 C105,1 96,1 96,8 C96,14 105,21 105,21 C105,21 114,14 114,8 C114,1 105,1 105,8Z" fill="#EE4D2D"/>
            </g>

            <!-- Ears -->
            <polygon points="66,42 80,12 96,42" fill="#FFA959" stroke="#E88A3C" stroke-width="2"/>
            <polygon points="73,39 80,20 89,39" fill="#FFB7C5"/>
            
            <polygon points="114,42 130,12 144,42" fill="#FFA959" stroke="#E88A3C" stroke-width="2"/>
            <polygon points="121,39 130,20 137,39" fill="#FFB7C5"/>

            <!-- Head Base -->
            <ellipse cx="105" cy="65" rx="46" ry="36" fill="#FFA959"/>
            
            <!-- White Face Patches -->
            <ellipse cx="105" cy="72" rx="30" ry="24" fill="#FFFBF5"/>
            <ellipse cx="80" cy="72" rx="12" ry="10" fill="#FFFBF5"/>
            <ellipse cx="130" cy="72" rx="12" ry="10" fill="#FFFBF5"/>

            <!-- Big Sparkle Eyes -->
            <ellipse cx="86" cy="62" rx="8" ry="9" fill="#2B1D0F"/>
            <circle cx="84" cy="59" r="3.5" fill="#FFFFFF"/>
            <circle cx="89" cy="65" r="1.6" fill="#FFFFFF"/>
            <circle cx="83" cy="66" r="1" fill="#FFFFFF"/>

            <ellipse cx="124" cy="62" rx="8" ry="9" fill="#2B1D0F"/>
            <circle cx="122" cy="59" r="3.5" fill="#FFFFFF"/>
            <circle cx="127" cy="65" r="1.6" fill="#FFFFFF"/>
            <circle cx="121" cy="66" r="1" fill="#FFFFFF"/>

            <!-- Blush Cheeks -->
            <ellipse cx="74" cy="70" rx="7" ry="4" fill="#FF8EA3" opacity="0.65"/>
            <ellipse cx="136" cy="70" rx="7" ry="4" fill="#FF8EA3" opacity="0.65"/>

            <!-- Little Nose -->
            <polygon points="105,68 101,72 109,72" fill="#FF708F"/>

            <!-- Cat Smile Mouth (ω shape) -->
            <path d="M98,76 Q101.5,80 105,76 Q108.5,80 112,76" stroke="#8C4A1E" stroke-width="2" fill="none" stroke-linecap="round"/>

            <!-- Whiskers -->
            <line x1="50" y1="67" x2="74" y2="70" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="48" y1="75" x2="73" y2="75" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="160" y1="67" x2="136" y2="70" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="162" y1="75" x2="137" y2="75" stroke="#D1834C" stroke-width="1.8" stroke-linecap="round"/>

            <!-- Paws Gripping the Edge -->
            <g class="cat-peek__paw-left">
              <ellipse cx="78" cy="96" rx="13" ry="7" fill="#FFFBF5" stroke="#FFA959" stroke-width="2.2"/>
              <ellipse cx="72" cy="94" rx="2.5" ry="2" fill="#FFB7C5"/>
              <ellipse cx="78" cy="92" rx="2.5" ry="2" fill="#FFB7C5"/>
              <ellipse cx="84" cy="94" rx="2.5" ry="2" fill="#FFB7C5"/>
            </g>

            <g class="cat-peek__paw-right">
              <ellipse cx="132" cy="96" rx="13" ry="7" fill="#FFFBF5" stroke="#FFA959" stroke-width="2.2"/>
              <ellipse cx="126" cy="94" rx="2.5" ry="2" fill="#FFB7C5"/>
              <ellipse cx="132" cy="92" rx="2.5" ry="2" fill="#FFB7C5"/>
              <ellipse cx="138" cy="94" rx="2.5" ry="2" fill="#FFB7C5"/>
            </g>
          </g>
        </svg>
      </div>
    </a>
  </div>
</aside>

<style>
  .cat-peek {
    position: fixed;
    bottom: -150px;
    left: var(--space-4, 16px);
    z-index: calc(var(--z-fixed, 100) + 10);
    transition: bottom 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    pointer-events: none;
    user-select: none;
  }

  .cat-peek--visible {
    bottom: 0px;
    pointer-events: auto;
  }

  .cat-peek--visible:hover {
    bottom: 4px;
  }

  .cat-peek__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .cat-peek__link {
    display: block;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    outline: none;
    line-height: 0;
  }

  .cat-peek__link:focus-visible {
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 0 0 3px var(--color-primary-500, #EE4D2D);
  }

  .cat-peek__stage {
    width: 170px;
    height: 93px;
    overflow: visible;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.16));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cat-peek__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cat-peek--visible:hover .cat-peek__stage {
    transform: scale(1.06);
  }

  /* ═══ Animations for the Trio ═══ */
  .cat-peek__mother-cat {
    transform-origin: 105px bottom;
    animation: motherWiggle 4s ease-in-out infinite;
  }

  .cat-peek__kitten-left {
    transform-origin: 41px bottom;
    animation: kittenLeftPeek 3.5s ease-in-out infinite 0.4s;
  }

  .cat-peek__kitten-right {
    transform-origin: 169px bottom;
    animation: kittenRightPeek 3.8s ease-in-out infinite 0.8s;
  }

  .cat-peek--visible:hover .cat-peek__mother-cat {
    animation: catExcitedBounce 0.45s ease-in-out;
  }

  .cat-peek--visible:hover .cat-peek__kitten-left {
    animation: catExcitedBounce 0.45s ease-in-out 0.1s;
  }

  .cat-peek--visible:hover .cat-peek__kitten-right {
    animation: catExcitedBounce 0.45s ease-in-out 0.2s;
  }

  @keyframes motherWiggle {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25% { transform: translateY(-2px) rotate(-2deg); }
    75% { transform: translateY(-1px) rotate(2deg); }
  }

  @keyframes kittenLeftPeek {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    35% { transform: translateY(-5px) rotate(-1deg); }
    70% { transform: translateY(-2px) rotate(-6deg); }
  }

  @keyframes kittenRightPeek {
    0%, 100% { transform: translateY(0) rotate(4deg); }
    40% { transform: translateY(-6px) rotate(1deg); }
    75% { transform: translateY(-1px) rotate(6deg); }
  }

  @keyframes catExcitedBounce {
    0% { transform: translateY(0); }
    30% { transform: translateY(-8px) scale(1.08); }
    60% { transform: translateY(-2px); }
    100% { transform: translateY(0); }
  }

  /* Floating Heart */
  .cat-peek__heart {
    animation: heartPulse 2.2s ease-in-out infinite;
    transform-origin: 105px 10px;
  }

  @keyframes heartPulse {
    0%, 100% { 
      transform: translateY(0) scale(1);
      opacity: 0.85;
    }
    50% { 
      transform: translateY(-5px) scale(1.25);
      opacity: 1;
    }
  }

  /* ═══ Speech Bubble (Luôn nằm trên đỉnh) ═══ */
  .cat-peek__bubble {
    position: relative;
    z-index: 10;
    margin-bottom: 8px;
    background: #FFFFFF;
    border: 2px solid #FFD4B8;
    border-radius: 16px;
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #EE4D2D;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(238, 77, 45, 0.2);
    opacity: 0;
    transform: scale(0.8) translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: auto;
  }

  .cat-peek__bubble::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid #FFFFFF;
    filter: drop-shadow(0 1px 0 #FFD4B8);
  }

  .cat-peek--visible .cat-peek__bubble {
    opacity: 1;
    transform: scale(1) translateY(0);
    transition-delay: 0.3s;
  }

  .cat-peek--visible:hover .cat-peek__bubble {
    background: #FFF5F0;
    border-color: #EE4D2D;
    transform: scale(1.04) translateY(-2px);
    transition-delay: 0s;
  }

  [data-theme="dark"] .cat-peek__bubble {
    background: #1E293B;
    border-color: #EE4D2D;
    color: #FFA585;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  [data-theme="dark"] .cat-peek__bubble::after {
    border-top-color: #1E293B;
    filter: drop-shadow(0 1px 0 #EE4D2D);
  }

  /* Dismiss Button */
  .cat-peek__dismiss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #F1F5F9;
    color: #64748B;
    border: none;
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, transform 0.2s;
    line-height: 1;
    padding: 0;
    margin-left: 2px;
  }

  .cat-peek__dismiss:hover {
    background: #EE4D2D;
    color: #FFFFFF;
    transform: scale(1.2) rotate(90deg);
  }

  [data-theme="dark"] .cat-peek__dismiss {
    background: #334155;
    color: #94A3B8;
  }

  [data-theme="dark"] .cat-peek__dismiss:hover {
    background: #EE4D2D;
    color: #FFFFFF;
  }

  /* ═══ Responsive Mobile ═══ */
  @media (max-width: 768px) {
    .cat-peek {
      left: var(--space-2, 8px);
    }
    .cat-peek__stage {
      width: 145px;
      height: 79px;
    }
    .cat-peek__bubble {
      font-size: 0.72rem;
      padding: 5px 9px;
      margin-bottom: 6px;
    }
    .cat-peek--visible {
      bottom: 0px;
    }
  }
</style>

<script is:inline>
  (() => {
    function initCatPeek() {
      const cat = document.getElementById('catPeek');
      const dismissBtn = document.getElementById('catPeekDismiss');
      const catLink = document.getElementById('catPeekLink');
      if (!cat) return;

      let shown = false;

      function showCat() {
        if (shown) return;
        shown = true;
        cat.classList.add('cat-peek--visible');
        cat.removeAttribute('aria-hidden');
        cat.removeAttribute('inert');
      }

      function hideCat() {
        cat.classList.remove('cat-peek--visible');
        cat.setAttribute('aria-hidden', 'true');
        cat.setAttribute('inert', '');
      }

      // Hiện nhanh sau 3.5 giây
      const timer = setTimeout(showCat, 3500);

      // Hoặc chỉ cần cuộn trang xuống 150px là hiện ngay
      const onScroll = () => {
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        if (scrollY > 150) {
          clearTimeout(timer);
          showCat();
          window.removeEventListener('scroll', onScroll);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });

      if (dismissBtn) {
        dismissBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          hideCat();
        });
      }

      if (catLink) {
        catLink.addEventListener('click', () => {
          hideCat();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatPeek);
    } else {
      initCatPeek();
    }
  })();
</script>
