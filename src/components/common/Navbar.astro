---
// Navbar Component with Pure SVG Vector Icons
const currentPath = Astro.url.pathname;
---

<header class="navbar" id="navbar">
  <div class="container navbar__inner">
    <!-- Brand Logo -->
    <a href="/" class="navbar__logo" title="ShopeeAffVN — Kinh nghiệm Shopee Affiliate">
      <span class="navbar__logo-icon">S</span>
      ShopeeAffVN
    </a>

    <!-- Navigation Links -->
    <nav class="navbar__nav" id="mainNav" aria-label="Điều hướng chính">
      <a href="/chuyen-muc/huong-dan" class={`navbar__link ${currentPath.includes('huong-dan') ? 'navbar__link--active' : ''}`}>
        Hướng Dẫn
      </a>
      <a href="/chuyen-muc/case-study" class={`navbar__link ${currentPath.includes('case-study') ? 'navbar__link--active' : ''}`}>
        Case Study
      </a>
      <a href="/chuyen-muc/chon-san-pham" class={`navbar__link ${currentPath.includes('chon-san-pham') ? 'navbar__link--active' : ''}`}>
        Chọn Sản Phẩm
      </a>
      <a href="/chuyen-muc/tao-content" class={`navbar__link ${currentPath.includes('tao-content') ? 'navbar__link--active' : ''}`}>
        Tạo Content
      </a>
      <a href="/chuyen-muc/traffic-seo" class={`navbar__link ${currentPath.includes('traffic-seo') ? 'navbar__link--active' : ''}`}>
        Traffic & SEO
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="navbar__actions">
      <a href="/search" class="navbar__search" aria-label="Tìm kiếm bài viết">
        <svg class="navbar__search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Tìm kiếm...</span>
      </a>

      <button class="theme-toggle" id="themeToggle" aria-label="Chuyển đổi giao diện Sáng / Tối" title="Chuyển đổi giao diện Sáng / Tối">
        <!-- Moon Icon (Shown in Light Mode) -->
        <svg class="theme-toggle__moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <!-- Sun Icon (Shown in Dark Mode) -->
        <svg class="theme-toggle__sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <button class="hamburger" id="hamburgerBtn" aria-label="Mở menu di động" aria-expanded="false">
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
        <span class="hamburger__line"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .navbar__search-icon {
    flex-shrink: 0;
    margin-right: 6px;
    color: var(--text-muted);
  }

  .theme-toggle__sun {
    display: none;
  }

  .theme-toggle__moon {
    display: block;
  }

  [data-theme="dark"] .theme-toggle__sun {
    display: block;
  }

  [data-theme="dark"] .theme-toggle__moon {
    display: none;
  }
</style>
