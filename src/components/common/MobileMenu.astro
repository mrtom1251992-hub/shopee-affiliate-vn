---
// Mobile Drawer Menu
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu__backdrop" id="menuBackdrop"></div>
  <div class="mobile-menu__drawer">
    <div class="mobile-menu__header">
      <a href="/" class="navbar__logo">
        <span class="navbar__logo-icon">S</span>
        ShopeeAffVN
      </a>
      <button class="mobile-menu__close" id="menuCloseBtn" aria-label="Đóng menu">
        ✕
      </button>
    </div>

    <div class="mobile-menu__search">
      <form action="/search" method="GET">
        <input 
          type="search" 
          name="q" 
          class="widget__input" 
          placeholder="🔍 Tìm kiếm bài viết Shopee..." 
          aria-label="Tìm kiếm bài viết"
        />
      </form>
    </div>

    <nav class="mobile-menu__nav" aria-label="Menu di động">
      <a href="/chuyen-muc/huong-dan" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">📖</span>
        Hướng Dẫn
      </a>
      <a href="/chuyen-muc/case-study" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">📊</span>
        Case Study
      </a>
      <a href="/chuyen-muc/chon-san-pham" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">🛍</span>
        Chọn Sản Phẩm
      </a>
      <a href="/chuyen-muc/tao-content" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">✏️</span>
        Tạo Content
      </a>
      <a href="/chuyen-muc/traffic-seo" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">🚀</span>
        Traffic & SEO
      </a>
      <a href="/bai-viet" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">📚</span>
        Tất Cả Bài Viết
      </a>
      <a href="/about" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">👤</span>
        Giới Thiệu
      </a>
      <a href="/contact" class="mobile-menu__link">
        <span class="mobile-menu__link-icon">✉️</span>
        Liên Hệ / Hợp Tác
      </a>
    </nav>

    <div class="mobile-menu__footer">
      <a href="https://affiliate.shopee.vn" target="_blank" rel="nofollow noopener" class="btn btn--primary" style="width: 100%;">
        Đăng Ký Shopee Affiliate →
      </a>
      <div class="mobile-menu__socials">
        <a href="https://www.facebook.com/profile.php?id=61593122652026" target="_blank" rel="noopener" aria-label="Facebook Fanpage">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://www.tiktok.com" target="_blank" rel="noopener" aria-label="Kênh TikTok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3 15.28 6.34 6.34 0 0 0 9.34 21.6a6.34 6.34 0 0 0 6.34-6.32V8.52a8.27 8.27 0 0 0 4.84 1.57v-3.4h-.93z"/>
          </svg>
        </a>
        <a href="https://t.me" target="_blank" rel="noopener" aria-label="Telegram Channel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
        </a>
        <a href="https://www.youtube.com" target="_blank" rel="noopener" aria-label="Kênh YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
