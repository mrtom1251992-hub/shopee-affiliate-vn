---
// Mobile Drawer Menu with Pure Vector SVG Icons
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true" inert>
  <div class="mobile-menu__backdrop" id="menuBackdrop"></div>
  <div class="mobile-menu__drawer">
    <div class="mobile-menu__header">
      <a href="/" class="navbar__logo">
        <span class="navbar__logo-icon">S</span>
        ShopeeAffVN
      </a>
      <button class="mobile-menu__close" id="menuCloseBtn" aria-label="Đóng menu">
        ✕
      </button>
    </div>

    <div class="mobile-menu__search">
      <form action="/search" method="GET">
        <input 
          type="search" 
          name="q" 
          class="widget__input" 
          placeholder="Tìm kiếm bài viết Shopee..." 
          aria-label="Tìm kiếm bài viết"
        />
      </form>
    </div>

    <nav class="mobile-menu__nav" aria-label="Menu di động">
      <a href="/chuyen-muc/huong-dan" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
        Hướng Dẫn Cơ Bản
      </a>

      <a href="/chuyen-muc/case-study" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        Case Study
      </a>

      <a href="/chuyen-muc/chon-san-pham" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        Chọn Sản Phẩm
      </a>

      <a href="/chuyen-muc/tao-content" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
          <line x1="7" y1="2" x2="7" y2="22"></line>
          <line x1="17" y1="2" x2="17" y2="22"></line>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <line x1="2" y1="7" x2="7" y2="7"></line>
          <line x1="2" y1="17" x2="7" y2="17"></line>
          <line x1="17" y1="17" x2="22" y2="17"></line>
          <line x1="17" y1="7" x2="22" y2="7"></line>
        </svg>
        Reels & Shorts
      </a>

      <a href="/chuyen-muc/traffic-seo" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        Traffic & SEO
      </a>

      <a href="/chuyen-muc/phan-tich" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
          <polyline points="17 6 23 6 23 12"></polyline>
        </svg>
        Bảng Hoa Hồng
      </a>

      <a href="/bai-viet" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          <path d="M9 12h6"></path>
          <path d="M9 16h6"></path>
        </svg>
        Tất Cả Bài Viết
      </a>

      <a href="/about" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        Giới Thiệu
      </a>

      <a href="/contact" class="mobile-menu__link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mobile-menu__svg-icon" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        Liên Hệ / Hợp Tác
      </a>
    </nav>

    <div class="mobile-menu__footer">
      <a href="/go" target="_blank" rel="nofollow noopener" class="btn btn--primary" style="width: 100%;">
        Ghé Shopee Storefront →
      </a>
      <div class="mobile-menu__socials">
        <a href="https://www.facebook.com/profile.php?id=61593122652026" target="_blank" rel="noopener" aria-label="Facebook Fanpage">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/groups/1366676725001050" target="_blank" rel="noopener" aria-label="Nhóm Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-menu__svg-icon {
    flex-shrink: 0;
    margin-right: 10px;
    color: var(--color-primary-600);
  }
</style>
