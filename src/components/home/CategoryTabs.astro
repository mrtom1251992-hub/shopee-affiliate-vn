---
// Category Tabs Component
interface Props {
  activeCategory?: string;
}

const { activeCategory = 'all' } = Astro.props;

const categories = [
  { slug: 'all', name: '📋 Tất Cả', url: '/bai-viet' },
  { slug: 'huong-dan', name: '📝 Hướng Dẫn Cơ Bản', url: '/chuyen-muc/huong-dan' },
  { slug: 'chon-san-pham', name: '🛍 Chọn Sản Phẩm', url: '/chuyen-muc/chon-san-pham' },
  { slug: 'case-study', name: '📊 Case Study', url: '/chuyen-muc/case-study' },
  { slug: 'tao-content', name: '🎬 Reels & Shorts', url: '/chuyen-muc/tao-content' },
  { slug: 'traffic-seo', name: '🔍 SEO & Group FB/Zalo', url: '/chuyen-muc/traffic-seo' },
  { slug: 'phan-tich', name: '📈 Bảng Hoa Hồng', url: '/chuyen-muc/phan-tich' },
];
---

<section class="tabs-section" aria-label="Phân loại chuyên mục">
  <div class="container">
    <div class="tabs" role="tablist">
      {categories.map((cat) => (
        <a 
          href={cat.url}
          class={`tab ${activeCategory === cat.slug ? 'tab--active' : ''}`}
          role="tab"
          aria-selected={activeCategory === cat.slug}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>
</section>
