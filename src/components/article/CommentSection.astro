---
interface Props {
  slug: string;
  commentsCount?: number;
}

const { slug, commentsCount = 0 } = Astro.props;

// Mock initial comments for display
const demoComments = [
  {
    author: "Nguyễn Văn Hùng",
    date: "14/08/2026",
    content: "Bài viết rất chi tiết và tâm huyết! Mình mới áp dụng cách làm video TikTok không lộ mặt tuần trước mà đã có 15 đơn đầu tiên rồi."
  },
  {
    author: "Thanh Trúc KOC",
    date: "13/08/2026",
    content: "Cảm ơn tác giả nhiều nhé. Phần phân tích hoa hồng Extra từ Shop giúp mình tối ưu doanh thu tăng gấp đôi luôn."
  }
];
---

<div class="comments-section" id="commentsSection">
  <div class="section-header">
    <h3 class="section-header__title">Bình Luận & Thảo Luận ({demoComments.length})</h3>
  </div>

  <div class="comments-list" id="commentsList">
    {demoComments.map((comment) => (
      <div class="comment-card">
        <div class="comment-card__header">
          <span class="comment-card__author">{comment.author}</span>
          <span class="comment-card__date">{comment.date}</span>
        </div>
        <p style="margin: 0; font-size: var(--font-size-sm); color: var(--text-secondary);">{comment.content}</p>
      </div>
    ))}
  </div>

  <form 
    class="comment-form" 
    id="commentForm"
    onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã gửi bình luận! Bình luận của bạn sẽ được hiển thị sau khi duyệt.'); this.reset();"
  >
    <h4 style="margin: 0; font-size: var(--font-size-base);">Gửi bình luận của bạn</h4>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
      <input type="text" required class="widget__input" placeholder="Họ và tên..." aria-label="Tên của bạn" />
      <input type="email" required class="widget__input" placeholder="Email (không công khai)..." aria-label="Email của bạn" />
    </div>
    <textarea required placeholder="Chia sẻ suy nghĩ hoặc câu hỏi của bạn về Shopee Affiliate..." aria-label="Nội dung bình luận"></textarea>
    <button type="submit" class="btn btn--primary" style="align-self: flex-start;">
      Gửi Bình Luận 💬
    </button>
  </form>
</div>
