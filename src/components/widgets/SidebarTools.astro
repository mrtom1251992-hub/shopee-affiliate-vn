---
// Sidebar Tools Widget with Premium SVG Vector Icons
---

<div class="widget" id="widgetTools">
  <h3 class="widget__title">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="widget__title-svg" aria-hidden="true">
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
    </svg>
    <span>Tool Hỗ Trợ Shopee Affiliate</span>
  </h3>
  <div class="widget__list">
    <a href="/go" target="_blank" rel="nofollow noopener" class="widget__item">
      <div class="widget__tool-icon widget__tool-icon--shopee">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <div class="widget__item-text">
        <div class="widget__item-name">Cổng Shopee Affiliate</div>
        <div class="widget__item-detail">Đăng ký & quản lý hoa hồng</div>
      </div>
      <span class="badge badge--primary">FREE</span>
    </a>
    
    <a href="https://trends.google.com" target="_blank" rel="nofollow noopener" class="widget__item">
      <div class="widget__tool-icon widget__tool-icon--trends">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
      </div>
      <div class="widget__item-text">
        <div class="widget__item-name">Google Trends & Shopee</div>
        <div class="widget__item-detail">Tìm kiếm sản phẩm đang hot trend</div>
      </div>
    </a>
    
    <a href="https://www.capcut.com" target="_blank" rel="nofollow noopener" class="widget__item">
      <div class="widget__tool-icon widget__tool-icon--capcut">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
          <line x1="7" y1="2" x2="7" y2="22"></line>
          <line x1="17" y1="2" x2="17" y2="22"></line>
          <line x1="2" y1="12" x2="22" y2="12"></line>
        </svg>
      </div>
      <div class="widget__item-text">
        <div class="widget__item-name">CapCut Video Editor</div>
        <div class="widget__item-detail">Dựng video review TikTok chuyên nghiệp</div>
      </div>
    </a>
  </div>
</div>

<style>
  .widget__title-svg {
    color: var(--color-primary-600);
    margin-right: 8px;
    flex-shrink: 0;
  }

  .widget__tool-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md, 8px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 12px;
    transition: transform var(--transition-fast);
  }

  .widget__tool-icon--shopee {
    background: #FFF0EB;
    color: #EE4D2D;
  }

  .widget__tool-icon--trends {
    background: #EFF6FF;
    color: #2563EB;
  }

  .widget__tool-icon--capcut {
    background: #F3E8FF;
    color: #9333EA;
  }

  [data-theme="dark"] .widget__tool-icon--shopee {
    background: rgba(238, 77, 45, 0.15);
    color: #FFA585;
  }

  [data-theme="dark"] .widget__tool-icon--trends {
    background: rgba(37, 99, 235, 0.15);
    color: #93C5FD;
  }

  [data-theme="dark"] .widget__tool-icon--capcut {
    background: rgba(147, 51, 234, 0.15);
    color: #D8B4FE;
  }

  .widget__item:hover .widget__tool-icon {
    transform: scale(1.12);
  }
</style>
