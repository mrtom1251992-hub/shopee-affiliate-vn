---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/seo/Breadcrumb.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import AffiliateCtaBox from '../components/article/AffiliateCtaBox.astro';
import AuthorBox from '../components/article/AuthorBox.astro';
import ShareButtons from '../components/article/ShareButtons.astro';
import CommunityGroupCta from '../components/article/CommunityGroupCta.astro';
import SidebarRoadmap from '../components/widgets/SidebarRoadmap.astro';
import SidebarTools from '../components/widgets/SidebarTools.astro';
import SidebarNewsletter from '../components/widgets/SidebarNewsletter.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'bai-viet'>;
  headings: { depth: number; slug: string; text: string }[];
  relatedArticles?: CollectionEntry<'bai-viet'>[];
}

const { article, headings } = Astro.props;
const { title, description, categoryName, category, publishDate, author, coverImage, hotBadge, affiliateUrl, affiliateCtaText } = article.data;

const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  day: 'numeric',
  month: 'numeric',
  year: 'numeric'
}).format(publishDate);
---

<BaseLayout 
  title={title} 
  description={description}
  articleDate={publishDate}
  articleAuthor={author}
>
  <div class="container" style="padding-top: var(--space-6);">
    <Breadcrumb items={[
      { name: categoryName, url: `/chuyen-muc/${category}` },
      { name: title }
    ]} />

    <section class="content-area" id="articleMain" style="padding-top: 0;">
      <!-- Left: Article Content -->
      <article class="content-main">
        <header class="article-header">
          <div class="article-header__meta">
            {hotBadge && <span class="badge badge--primary">{hotBadge}</span>}
            <a href={`/chuyen-muc/${category}`} class="badge badge--accent">{categoryName}</a>
            <span class="card__date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="card__date-icon" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>{formattedDate}</span>
            </span>
          </div>

          <h1 class="article-header__title">{title}</h1>
          <p class="article-header__lead">{description}</p>

          {coverImage && (
            <div class="article-header__cover">
              <img 
                src={coverImage} 
                alt={title} 
                loading="eager" 
                decoding="async" 
                fetchpriority="high"
                width="1200" 
                height="675" 
              />
            </div>
          )}
        </header>

        <TableOfContents headings={headings} />

        <div class="prose">
          <slot />
        </div>

        <AffiliateCtaBox 
          title={affiliateCtaText || "Đăng Ký Shopee Affiliate Ngay Hôm Nay"}
          description="Đăng ký tài khoản Shopee Affiliate hoàn toàn miễn phí. Hưởng mức hoa hồng lên đến 20-30% cho mỗi đơn hàng thành công."
          buttonText={affiliateCtaText || "Đăng Ký Shopee Affiliate Miễn Phí →"}
          affiliateUrl={affiliateUrl || "/go"}
        />

        <ShareButtons title={title} />
        <AuthorBox author={author} />
        
        <!-- Replaced fake comments with real Facebook Community Group CTA -->
        <CommunityGroupCta />
      </article>

      <!-- Right: Sticky Sidebar -->
      <aside class="content-sidebar" id="articleSidebar">
        <SidebarRoadmap />
        <SidebarTools />
        <SidebarNewsletter />
      </aside>
    </section>
  </div>
</BaseLayout>
