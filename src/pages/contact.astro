---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/seo/Breadcrumb.astro';
import SidebarRoadmap from '../components/widgets/SidebarRoadmap.astro';
import SidebarTools from '../components/widgets/SidebarTools.astro';
import SidebarNewsletter from '../components/widgets/SidebarNewsletter.astro';
---

<BaseLayout 
  title="Liên Hệ & Hợp Tác — ShopeeAffVN"
  description="Liên hệ trực tiếp với ban quản trị ShopeeAffVN qua Facebook Messenger hoặc Fanpage để trao đổi kinh nghiệm."
>
  <div class="container" style="padding-top: var(--space-6);">
    <Breadcrumb items={[{ name: "Liên Hệ" }]} />

    <section class="content-area" style="padding-top: 0;">
      <div class="content-main">
        <header class="article-header">
          <h1 class="article-header__title">Liên Hệ Trực Tiếp</h1>
          <p class="article-header__lead">
            Bạn có câu hỏi cần giải đáp hoặc muốn trao đổi thêm kinh nghiệm về Shopee Affiliate? Hãy nhắn tin trực tiếp cho mình qua các kênh dưới đây:
          </p>
        </header>

        <!-- Direct Contact Channels -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); margin-bottom: var(--space-8);">
          <!-- Facebook Fanpage -->
          <div class="widget" style="padding: var(--space-6); text-align: center; border-top: 4px solid #1877F2;">
            <div style="width: 50px; height: 50px; margin: 0 auto var(--space-3); background: rgba(24, 119, 242, 0.1); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; color: #1877F2;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </div>
            <h3 style="margin-bottom: var(--space-2); font-size: var(--font-size-base);">Facebook Fanpage</h3>
            <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: var(--space-4);">
              Nhắn tin trực tiếp qua Fanpage để được giải đáp thắc mắc nhanh nhất.
            </p>
            <a href="https://www.facebook.com/profile.php?id=61593122652026" target="_blank" rel="noopener" class="btn btn--primary btn--sm" style="width: 100%;">
              Nhắn Tin Fanpage →
            </a>
          </div>

          <!-- Facebook Messenger Direct -->
          <div class="widget" style="padding: var(--space-6); text-align: center; border-top: 4px solid var(--color-primary-500);">
            <div style="width: 50px; height: 50px; margin: 0 auto var(--space-3); background: var(--color-primary-50); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); font-size: 1.5rem;">
              💬
            </div>
            <h3 style="margin-bottom: var(--space-2); font-size: var(--font-size-base);">Chat Messenger</h3>
            <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: var(--space-4);">
              Mở khung chat Messenger trực tiếp không cần lưu danh bạ.
            </p>
            <a href="https://m.me/61593122652026" target="_blank" rel="noopener" class="btn btn--outline btn--sm" style="width: 100%;">
              Mở Khung Chat 💬
            </a>
          </div>
        </div>

        <!-- Quick Question Box -->
        <div class="cta-box" style="text-align: left; padding: var(--space-6);">
          <h3 class="cta-box__title" style="font-size: var(--font-size-lg);">💡 Bạn có câu hỏi về Shopee Affiliate?</h3>
          <p class="cta-box__desc" style="font-size: var(--font-size-sm); margin-bottom: var(--space-4);">
            Bạn có thể để lại câu hỏi trực tiếp dưới phần bình luận ở cuối mỗi bài viết, hoặc gửi tin nhắn qua Fanpage. Mình sẽ hỗ trợ giải đáp hoàn toàn miễn phí cho bạn!
          </p>
          <a href="https://www.facebook.com/profile.php?id=61593122652026" target="_blank" rel="noopener" class="btn btn--sm">
            Ghé Thăm Fanpage Facebook →
          </a>
        </div>
      </div>

      <aside class="content-sidebar">
        <SidebarRoadmap />
        <SidebarTools />
        <SidebarNewsletter />
      </aside>
    </section>
  </div>
</BaseLayout>
